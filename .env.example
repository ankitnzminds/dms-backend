# Placeholders only - never commit real values. Copy to .env for local development.
APP_ENV=development                 # development | test | staging | production
API_V1_PREFIX=/api/v1
PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Database (server side only). Supabase: Project Settings > Database > connection string.
DATABASE_URL=                        # postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Authentication
AUTH_PROVIDER=supabase               # supabase | local (local = development/test only)
SUPABASE_URL=                        # https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=                 # only for legacy HS256 projects; leave empty with asymmetric JWT signing keys
LOCAL_JWT_SECRET=                    # development/test only (>= 32 chars)

# --- Object storage
STORAGE_PROVIDER=supabase            # supabase | local (local = development/test only)
SUPABASE_SERVICE_ROLE_KEY=           # SERVER ONLY. Never expose to the browser / NEXT_PUBLIC_*
SUPABASE_STORAGE_BUCKET=dms-private  # must be a PRIVATE bucket
LOCAL_STORAGE_PATH=.local-storage
MAX_UPLOAD_BYTES=104857600
BLOCKED_EXTENSIONS=exe,dll,bat,cmd,com,scr,msi,vbs,ps1,jar,sh,apk
DOWNLOAD_SIGNING_SECRET=             # >= 32 random chars; required in staging/production
DOWNLOAD_URL_TTL_SECONDS=60

# --- Malware scanning (staging/production require clamd)
MALWARE_SCANNER=none                 # clamd | eicar (dev/test) | none
CLAMD_HOST=localhost
CLAMD_PORT=3310

# --- Operations
RATE_LIMIT_ENABLED=true
METRICS_TOKEN=                       # when empty, /metrics is disabled

# --- E-signature (Documenso). SIGNATURE_PROVIDER=auto uses Documenso when URL+key are set.
SIGNATURE_PROVIDER=auto
DOCUMENSO_URL=
DOCUMENSO_API_KEY=
DOCUMENSO_WEBHOOK_SECRET=

# --- AI assistant. AI_PROVIDER=auto picks gemini when GEMINI_API_KEY is set, else groq when
# GROQ_API_KEY is set, else none. Set gemini|groq explicitly to force one.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Model used to transcribe scanned documents (empty = GEMINI_MODEL); a *-flash-lite model is
# faster and has a larger free-tier quota.
GEMINI_OCR_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_INPUT_CHARS=40000
AI_TIMEOUT_SECONDS=60
# Gemini only: transcribe scanned PDFs/images that have no usable text layer (search + chat).
AI_OCR=true
AI_OCR_MAX_BYTES=20971520
AI_OCR_TIMEOUT_SECONDS=300

# --- Agent limits (chatbot)
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_RUNTIME_SECONDS=120
AGENT_MAX_BULK_ITEMS=50
AGENT_ACTION_TTL_MINUTES=15
AGENT_HISTORY_MESSAGES=12
AGENT_RUN_MODE=thread

# --- E-mail (optional; notifications are in-app regardless)
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
WEB_BASE_URL=http://localhost:3000

# --- Office viewer/editor (Collabora Online via WOPI). Empty COLLABORA_URL = feature off.
COLLABORA_URL=
COLLABORA_DISCOVERY_URL=
WOPI_HOST_URL=
WOPI_TOKEN_TTL_SECONDS=3600
OFFICE_MAX_BYTES=52428800
